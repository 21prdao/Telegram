# Server bootstrap
PORT=8787
TRUST_PROXY=1

# Chain / contract bootstrap values. These are startup-level values and are not edited in admin.
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
RED_PACKET_CONTRACT=0x5a6361A5Af1c56eDF7E6e9e0B191a92BBf957fC3

# MySQL bootstrap values. The service uses this database to store red packets, versions and admin-managed settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=telegram_red_packet

# Runtime setting seeds. They are inserted into system_settings only when the key does not already exist.
# After first startup, edit them in Admin -> 系统状态 -> 运行参数配置.
PUBLIC_HOST=http://127.0.0.1:8787
MAX_EXPIRES_IN_SECONDS=2592000
DEFAULT_PROXY_ADDRESS=139.180.223.206
DEFAULT_PROXY_PORT=443
DEFAULT_PROXY_USERNAME=
DEFAULT_PROXY_PASSWORD=
DEFAULT_PROXY_SECRET=aff4456037ec453cde85935760a840f0
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0.0
APP_DOWNLOAD_URL=
APP_VERSION_MESSAGE=
APP_RELEASE_DATE=0
APP_APK_SIZE_BYTES=0
APP_UPLOAD_PUBLIC_PATH=/uploads/apks
APP_UPLOAD_DIR=./uploads/apks
APP_UPLOAD_URL_BASE=
MAX_APK_UPLOAD_BYTES=157286400

# Admin API / auth. Keep these in deployment env; do not expose them through runtime settings.
ADMIN_API_BASE_PATH=/api/admin
ADMIN_WEB_BASE_PATH=/admin
ADMIN_WEB_DIST=./admin-web/dist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=change_this_long_random_secret
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_COOKIE_NAME=rp_admin_session

# Only needed when admin-web is hosted on another origin instead of Vite proxy / same-origin deployment.
# Example: ADMIN_CORS_ORIGIN=http://127.0.0.1:5173
ADMIN_CORS_ORIGIN=
